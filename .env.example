# Copy to .env (gitignored) and fill in. NEVER commit real values or paste them on the board.
# App runtime model key (used by the app itself, not for building it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

LINKUP_API_KEY=

DATABRICKS_HOST=
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
# Databricks Apps service principal (OAuth M2M) instead of a token when deployed
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=resource

COMPANIES_HOUSE_API_KEY=

MLFLOW_TRACKING_URI=databricks
MLFLOW_EXPERIMENT_ID=
DATABRICKS_GENIE_SPACE_ID=
DATABRICKS_APP_NAME=resource

# Optional app settings (defaults shown)
# RS_OPERATIONAL_DB_URL=            # postgresql+psycopg://... for Lakebase; empty = local SQLite in var/
# RS_EXTRACTION_BACKEND=auto        # auto|databricks|openai|structured
# RS_MODEL_ENABLED=true
# RS_DATABRICKS_ENABLED=true
# RS_DELTA_PROJECTION=true
# RS_TRACING=true
# RS_LINKUP_ENABLED=true
# RS_COMPANIES_HOUSE_ENABLED=true
# RS_FOLLOWUP_ATTEMPTS=2
# RS_RUN_TOOL_BUDGET=80
# RS_MAX_CASE_WORKERS=3
# RS_PACING_MS=350                  # presentation pacing between visible steps; 0 in tests
# RS_FIXTURE_VERSION=seed-v1
# RS_MANIFEST=engine-demo-001
# RS_VAR_DIR=var

# Public supply-risk context search (server only; used alongside Linkup).
TAVILY_API_KEY=
