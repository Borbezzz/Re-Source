{
  "$defs": {
    "DataOrigin": {
      "enum": [
        "synthetic_demo",
        "public_source",
        "provided_document",
        "computed"
      ],
      "title": "DataOrigin",
      "type": "string"
    },
    "DiscoveryLocation": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country"
        },
        "data_origin": {
          "$ref": "#/$defs/DataOrigin"
        },
        "geo_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Geo Id"
        },
        "latitude": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latitude"
        },
        "location_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location Type"
        },
        "longitude": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Longitude"
        },
        "precision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precision"
        },
        "site_id": {
          "title": "Site Id",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        }
      },
      "required": [
        "site_id",
        "data_origin"
      ],
      "title": "DiscoveryLocation",
      "type": "object"
    },
    "Route": {
      "enum": [
        "BUY",
        "MAKE"
      ],
      "title": "Route",
      "type": "string"
    },
    "SupplierDiscovery": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "component_id": {
          "title": "Component Id",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/DiscoveryLocation"
        },
        "replay": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replay"
        },
        "replay_of_event": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replay Of Event"
        },
        "route": {
          "$ref": "#/$defs/Route"
        },
        "supplier_id": {
          "title": "Supplier Id",
          "type": "string"
        }
      },
      "required": [
        "component_id",
        "candidate_id",
        "supplier_id",
        "route",
        "location"
      ],
      "title": "SupplierDiscovery",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "case_revision": {
      "title": "Case Revision",
      "type": "integer"
    },
    "data": {
      "$ref": "#/$defs/SupplierDiscovery"
    },
    "data_origin": {
      "$ref": "#/$defs/DataOrigin",
      "default": "synthetic_demo"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "evidence_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "invocation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Invocation Id"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "scenario_run_id": {
      "title": "Scenario Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.2",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "title": "Sequence",
      "type": "integer"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Id"
    },
    "trace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trace Id"
    },
    "type": {
      "const": "supplier.discovered",
      "default": "supplier.discovered",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "sequence",
    "occurred_at",
    "scenario_run_id",
    "case_id",
    "case_revision",
    "summary",
    "data"
  ],
  "title": "SupplierDiscoveryEvent",
  "type": "object"
}
