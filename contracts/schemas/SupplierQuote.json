{
  "$defs": {
    "QuoteTerm": {
      "additionalProperties": false,
      "properties": {
        "excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        },
        "origin": {
          "default": "extracted",
          "enum": [
            "extracted",
            "buyer_review"
          ],
          "title": "Origin",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "value": {
          "maxLength": 1000,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "QuoteTerm",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "filename": {
      "title": "Filename",
      "type": "string"
    },
    "follow_up": {
      "default": "",
      "title": "Follow Up",
      "type": "string"
    },
    "input_version": {
      "title": "Input Version",
      "type": "integer"
    },
    "issues": {
      "items": {
        "type": "string"
      },
      "title": "Issues",
      "type": "array"
    },
    "part_id": {
      "title": "Part Id",
      "type": "string"
    },
    "quote_id": {
      "title": "Quote Id",
      "type": "string"
    },
    "reviewed": {
      "default": false,
      "title": "Reviewed",
      "type": "boolean"
    },
    "source_kind": {
      "enum": [
        "pdf",
        "reply"
      ],
      "title": "Source Kind",
      "type": "string"
    },
    "source_text": {
      "title": "Source Text",
      "type": "string"
    },
    "source_url": {
      "title": "Source Url",
      "type": "string"
    },
    "supplier": {
      "title": "Supplier",
      "type": "string"
    },
    "terms": {
      "additionalProperties": {
        "$ref": "#/$defs/QuoteTerm"
      },
      "propertyNames": {
        "enum": [
          "part_number",
          "revision",
          "material",
          "quantity",
          "unit_price",
          "currency",
          "minimum_order",
          "lead_time",
          "delivery_date",
          "quote_date",
          "valid_until",
          "shipping",
          "destination",
          "certificates",
          "exceptions"
        ]
      },
      "title": "Terms",
      "type": "object"
    },
    "version": {
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "quote_id",
    "part_id",
    "supplier",
    "filename",
    "source_kind",
    "source_url",
    "source_text",
    "created_at",
    "input_version",
    "version",
    "terms"
  ],
  "title": "SupplierQuote",
  "type": "object"
}
