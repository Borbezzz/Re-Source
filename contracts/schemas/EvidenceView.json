{
  "$defs": {
    "DataOrigin": {
      "enum": [
        "synthetic_demo",
        "public_source",
        "provided_document",
        "computed"
      ],
      "title": "DataOrigin",
      "type": "string"
    },
    "EvidenceVersion": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "title": "Authority",
          "type": "string"
        },
        "authority_rank": {
          "description": "Higher wins in conflict resolution",
          "title": "Authority Rank",
          "type": "integer"
        },
        "content_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Text"
        },
        "data_origin": {
          "$ref": "#/$defs/DataOrigin",
          "default": "synthetic_demo"
        },
        "doc_type": {
          "title": "Doc Type",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "effective_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective At"
        },
        "expiry_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expiry At"
        },
        "hash": {
          "title": "Hash",
          "type": "string"
        },
        "issuer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issuer"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "site_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Site Id"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "storage_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Storage Uri"
        },
        "subject_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Subject Ids",
          "type": "array"
        },
        "supersedes_version_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Version Id"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "validation_state": {
          "default": "unvalidated",
          "enum": [
            "valid",
            "invalid",
            "unvalidated",
            "superseded"
          ],
          "title": "Validation State",
          "type": "string"
        },
        "version_id": {
          "title": "Version Id",
          "type": "string"
        }
      },
      "required": [
        "version_id",
        "document_id",
        "title",
        "doc_type",
        "hash",
        "authority",
        "authority_rank",
        "retrieved_at"
      ],
      "title": "EvidenceVersion",
      "type": "object"
    },
    "ExtractedFact": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "evidence_version_id": {
          "title": "Evidence Version Id",
          "type": "string"
        },
        "extraction_mode": {
          "default": "fixture",
          "title": "Extraction Mode",
          "type": "string"
        },
        "fact_id": {
          "title": "Fact Id",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/Locator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "original_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Value"
        },
        "typed_value": {
          "title": "Typed Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "validation_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation Note"
        },
        "validation_state": {
          "default": "unvalidated",
          "enum": [
            "valid",
            "invalid",
            "unvalidated"
          ],
          "title": "Validation State",
          "type": "string"
        }
      },
      "required": [
        "fact_id",
        "evidence_version_id",
        "field",
        "typed_value"
      ],
      "title": "ExtractedFact",
      "type": "object"
    },
    "Locator": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        }
      },
      "title": "Locator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "evidence": {
      "$ref": "#/$defs/EvidenceVersion"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/ExtractedFact"
      },
      "title": "Facts",
      "type": "array"
    },
    "preview_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preview Text"
    },
    "status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status"
    },
    "superseded_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Superseded By"
    },
    "used_by_checks": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Used By Checks",
      "type": "array"
    }
  },
  "required": [
    "evidence",
    "facts"
  ],
  "title": "EvidenceView",
  "type": "object"
}
