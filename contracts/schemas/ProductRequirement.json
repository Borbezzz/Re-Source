{
  "$defs": {
    "ProductSource": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "quote": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "quote"
      ],
      "title": "ProductSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "key": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_-]+$",
      "title": "Key",
      "type": "string"
    },
    "label": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProductSource"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "default": "proposed",
      "enum": [
        "proposed",
        "confirmed"
      ],
      "title": "Status",
      "type": "string"
    },
    "unit": {
      "anyOf": [
        {
          "maxLength": 50,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    },
    "value": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Value",
      "type": "string"
    }
  },
  "required": [
    "key",
    "label",
    "value"
  ],
  "title": "ProductRequirement",
  "type": "object"
}
