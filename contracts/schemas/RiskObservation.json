{
  "$defs": {
    "RiskEvidence": {
      "additionalProperties": false,
      "properties": {
        "arrival_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrival On"
        },
        "destination": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Destination"
        },
        "event": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event"
        },
        "evidence_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "excerpt": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "issued_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issued On"
        },
        "kind": {
          "enum": [
            "quote",
            "backorder",
            "shipment",
            "delivery",
            "route_disruption",
            "material_trend",
            "freight_pressure"
          ],
          "title": "Kind",
          "type": "string"
        },
        "origin": {
          "default": "provided_document",
          "enum": [
            "provided_document",
            "synthetic_demo"
          ],
          "title": "Origin",
          "type": "string"
        },
        "part_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Part Id",
          "type": "string"
        },
        "part_number": {
          "anyOf": [
            {
              "maxLength": 150,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Part Number"
        },
        "quantity": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "revision": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "route": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route"
        },
        "source_document_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Document Id"
        },
        "source_url": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "source_version": {
          "default": "1",
          "maxLength": 100,
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        },
        "supplier": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supplier"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "unverified_reason": {
          "anyOf": [
            {
              "maxLength": 400,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unverified Reason"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        }
      },
      "required": [
        "evidence_id",
        "part_id",
        "kind",
        "title",
        "excerpt"
      ],
      "title": "RiskEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "applies_because": {
      "title": "Applies Because",
      "type": "string"
    },
    "days_late": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Days Late"
    },
    "evidence": {
      "$ref": "#/$defs/RiskEvidence"
    },
    "level": {
      "enum": [
        "alert",
        "watchlist",
        "matched",
        "superseded"
      ],
      "title": "Level",
      "type": "string"
    }
  },
  "required": [
    "evidence",
    "level",
    "applies_because"
  ],
  "title": "RiskObservation",
  "type": "object"
}
