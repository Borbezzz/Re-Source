{
  "$defs": {
    "DataOrigin": {
      "enum": [
        "synthetic_demo",
        "public_source",
        "provided_document",
        "computed"
      ],
      "title": "DataOrigin",
      "type": "string"
    },
    "MeshMapping": {
      "additionalProperties": false,
      "properties": {
        "camera_focus": {
          "additionalProperties": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "description": "{position:[x,y,z], target:[x,y,z]}",
          "title": "Camera Focus",
          "type": "object"
        },
        "exploded_offset": {
          "description": "[x,y,z] offset applied in exploded view",
          "items": {
            "type": "number"
          },
          "title": "Exploded Offset",
          "type": "array"
        },
        "hotspot_anchor": {
          "description": "[x,y,z] world-space anchor for the hotspot",
          "items": {
            "type": "number"
          },
          "title": "Hotspot Anchor",
          "type": "array"
        },
        "node_name": {
          "title": "Node Name",
          "type": "string"
        },
        "removal_vector": {
          "description": "[x,y,z] direction used by the removal animation",
          "items": {
            "type": "number"
          },
          "title": "Removal Vector",
          "type": "array"
        }
      },
      "required": [
        "node_name",
        "hotspot_anchor",
        "exploded_offset",
        "camera_focus",
        "removal_vector"
      ],
      "title": "MeshMapping",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "component_id": {
      "title": "Component Id",
      "type": "string"
    },
    "data_origin": {
      "$ref": "#/$defs/DataOrigin",
      "default": "synthetic_demo"
    },
    "display_name": {
      "title": "Display Name",
      "type": "string"
    },
    "engine_id": {
      "title": "Engine Id",
      "type": "string"
    },
    "failure_story": {
      "additionalProperties": true,
      "title": "Failure Story",
      "type": "object"
    },
    "mesh_mapping": {
      "$ref": "#/$defs/MeshMapping"
    },
    "part_identity": {
      "title": "Part Identity",
      "type": "string"
    },
    "position": {
      "title": "Position",
      "type": "string"
    },
    "requirement_set_id": {
      "title": "Requirement Set Id",
      "type": "string"
    },
    "revision": {
      "title": "Revision",
      "type": "string"
    },
    "short_description": {
      "title": "Short Description",
      "type": "string"
    }
