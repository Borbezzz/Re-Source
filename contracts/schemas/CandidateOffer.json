{
  "$defs": {
    "DataOrigin": {
      "enum": [
        "synthetic_demo",
        "public_source",
        "provided_document",
        "computed"
      ],
      "title": "DataOrigin",
      "type": "string"
    },
    "Money": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "description": "Decimal amount as a string-safe decimal",
          "title": "Amount",
          "type": "string"
        },
        "currency": {
          "description": "ISO 4217 code",
          "maxLength": 3,
          "minLength": 3,
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    },
    "Route": {
      "enum": [
        "BUY",
        "MAKE"
      ],
      "title": "Route",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "title": "Candidate Id",
      "type": "string"
    },
    "capacity": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Capacity"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "condition": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Condition"
    },
    "data_origin": {
      "$ref": "#/$defs/DataOrigin",
      "default": "synthetic_demo"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "label": {
      "title": "Label",
      "type": "string"
    },
    "logistics_route_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Logistics Route Id"
    },
    "manufacturer_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manufacturer Id"
    },
    "part_id": {
      "title": "Part Id",
      "type": "string"
    },
    "plan_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plan Id"
    },
    "price": {
      "$ref": "#/$defs/Money"
    },
    "quantity": {
      "default": 1,
      "title": "Quantity",
      "type": "integer"
    },
    "quote_version": {
      "title": "Quote Version",
      "type": "string"
    },
    "revision": {
      "title": "Revision",
      "type": "string"
    },
    "route": {
      "$ref": "#/$defs/Route"
    },
    "route_specific": {
      "additionalProperties": true,
      "default": {},
      "title": "Route Specific",
      "type": "object"
    },
    "seller_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seller Id"
    },
    "site_id": {
      "title": "Site Id",
      "type": "string"
    },
    "source_adapter": {
      "default": "seeded_offers",
      "title": "Source Adapter",
      "type": "string"
    },
    "stock": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stock"
    },
    "supplier_id": {
      "title": "Supplier Id",
      "type": "string"
    }
  },
  "required": [
    "candidate_id",
    "case_id",
    "route",
    "label",
    "part_id",
    "revision",
    "supplier_id",
    "site_id",
    "quote_version",
    "price"
  ],
  "title": "CandidateOffer",
  "type": "object"
}
