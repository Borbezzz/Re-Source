      "type": "string"
    },
    "expected": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/MeshExpectation"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
