{
  "$defs": {
    "MeshExpectation": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "title": "Component Id",
          "type": "string"
        },
        "node_name": {
          "title": "Node Name",
          "type": "string"
        },
        "source_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "component_id",
        "node_name"
      ],
      "title": "MeshExpectation",
      "type": "object"
    },
    "SourceRef": {
