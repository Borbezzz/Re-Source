{
  "$defs": {
    "CostLine": {
      "additionalProperties": false,
      "properties": {
        "converted": {
          "$ref": "#/$defs/Money"
        },
        "fx_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fx Version"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "original": {
          "$ref": "#/$defs/Money"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "label",
        "original",
        "converted",
        "source"
      ],
      "title": "CostLine",
      "type": "object"
    },
    "DataOrigin": {
      "enum": [
        "synthetic_demo",
        "public_source",
        "provided_document",
        "computed"
      ],
      "title": "DataOrigin",
      "type": "string"
    },
    "Duration": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "default": "days",
          "enum": [
            "hours",
            "days"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value"
      ],
      "title": "Duration",
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "description": "Decimal amount as a string-safe decimal",
          "title": "Amount",
          "type": "string"
        },
        "currency": {
          "description": "ISO 4217 code",
          "maxLength": 3,
          "minLength": 3,
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    },
    "PlanStep": {
      "additionalProperties": false,
      "properties": {
        "adjusted_by": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Adjusted By",
          "type": "array"
        },
        "assumption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assumption"
        },
        "depends_on": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "duration": {
          "$ref": "#/$defs/Duration"
        },
        "duration_range": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Range"
        },
        "finish_day": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finish Day"
        },
        "kind": {
          "enum": [
            "procurement",
            "manufacture",
            "qualification",
            "transport",
            "inspection",
            "installation",
            "documentation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "on_critical_path": {
          "default": false,
          "title": "On Critical Path",
          "type": "boolean"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "start_day": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Day"
        },
        "step_id": {
          "title": "Step Id",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "name",
        "kind",
        "duration",
        "source"
      ],
      "title": "PlanStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "candidate_id": {
      "title": "Candidate Id",
      "type": "string"
    },
    "cost_breakdown": {
      "items": {
        "$ref": "#/$defs/CostLine"
      },
      "title": "Cost Breakdown",
      "type": "array"
    },
    "critical_path": {
      "items": {
        "type": "string"
      },
      "title": "Critical Path",
      "type": "array"
    },
    "data_origin": {
      "$ref": "#/$defs/DataOrigin",
      "default": "synthetic_demo"
    },
    "elapsed_days": {
      "title": "Elapsed Days",
      "type": "number"
    },
    "finish_day": {
      "title": "Finish Day",
      "type": "number"
    },
    "input_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "title": "Input Versions",
      "type": "object"
    },
    "labour_days": {
      "title": "Labour Days",
      "type": "number"
    },
    "landed_cost": {
      "$ref": "#/$defs/Money"
    },
    "plan_id": {
      "title": "Plan Id",
      "type": "string"
    },
    "solver": {
      "enum": [
        "dependency_cpm",
        "cp_sat"
      ],
      "title": "Solver",
      "type": "string"
    },
    "solver_detail": {
      "additionalProperties": true,
      "default": {},
      "title": "Solver Detail",
      "type": "object"
    },
    "solver_status": {
      "title": "Solver Status",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/PlanStep"
      },
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "plan_id",
    "candidate_id",
    "steps",
    "assumptions",
    "finish_day",
    "elapsed_days",
    "labour_days",
    "critical_path",
    "cost_breakdown",
    "landed_cost",
    "solver",
    "solver_status"
  ],
  "title": "RecoveryPlan",
  "type": "object"
}
